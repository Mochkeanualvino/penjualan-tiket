        <mxCell id="title" value="Entity Relationship Diagram (ERD) - Database Bioskop" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="440" height="30" as="geometry" />
        </mxCell>

        <!-- USERS TABLE -->
        <mxCell id="tbl_users" value="USERS&#xa;---------------------------------------&#xa;PK id : VARCHAR(255)&#xa;   name : VARCHAR(255)&#xa;   email : VARCHAR(255) [UK]&#xa;   password : VARCHAR(255)&#xa;   role : VARCHAR(50)&#xa;   created_at : TIMESTAMP&#xa;   updated_at : TIMESTAMP" style="shape=rect;whiteSpace=pre;html=1;align=left;spacingLeft=10;fillColor=#e7f5ff;strokeColor=#1971c2;fontFamily=Courier New;fontSize=12;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="240" height="150" as="geometry" />
        </mxCell>

        <!-- FILMS TABLE -->
        <mxCell id="tbl_films" value="FILMS&#xa;---------------------------------------&#xa;PK id : VARCHAR(255)&#xa;   judul : VARCHAR(255)&#xa;   genre : VARCHAR(100)&#xa;   durasi : INTEGER&#xa;   rating_usia : VARCHAR(20)&#xa;   poster_url : TEXT&#xa;   is_segera_tayang : BOOLEAN&#xa;   created_at : TIMESTAMP&#xa;   updated_at : TIMESTAMP" style="shape=rect;whiteSpace=pre;html=1;align=left;spacingLeft=10;fillColor=#e6fcf5;strokeColor=#0ca678;fontFamily=Courier New;fontSize=12;fontStyle=0;" vertex="1" parent="1">
