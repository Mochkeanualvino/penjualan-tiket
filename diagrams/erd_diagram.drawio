        <mxCell id="rel_u_trx" value="1 : N&#xa;melakukan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.25;strokeColor=#fa5252;strokeWidth=2;endArrow=ERmany;startArrow=ERone;" edge="1" source="tbl_users" target="tbl_transaksis" parent="1">
