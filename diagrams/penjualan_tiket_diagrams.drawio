        <mxCell id="ll_ctrl" value="TransaksiController&#xa;(Laravel API)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe3e3;strokeColor=#c92a2a;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="80" width="140" height="600" as="geometry" />
        </mxCell>
        <mxCell id="ll_db" value="Database&#xa;(SQLite / MySQL)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f3f0ff;strokeColor=#5f3dc4;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="80" width="120" height="600" as="geometry" />
        </mxCell>

        <mxCell id="msg1" value="1. Pilih Kursi [A1, A2] &amp; Klik Pesan" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_user" target="ll_ui"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="160" /></Array></mxGeometry></mxCell>
        <mxCell id="msg2" value="2. setSelectedKursi(['A1','A2'])" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_ui" target="ll_prov"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="190" /></Array></mxGeometry></mxCell>
        <mxCell id="msg3" value="3. Input Metode Bayar &amp; Submit" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_user" target="ll_ui"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="240" /></Array></mxGeometry></mxCell>
        <mxCell id="msg4" value="4. submitTransaksi(trxData)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_ui" target="ll_prov"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="270" /></Array></mxGeometry></mxCell>
        <mxCell id="msg5" value="5. post('/api/v1/transaksi', payload)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_prov" target="ll_api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="300" /></Array></mxGeometry></mxCell>
        <mxCell id="msg6" value="6. HTTP POST + Bearer Token" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_api" target="ll_ctrl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="330" /></Array></mxGeometry></mxCell>
        <mxCell id="msg7" value="7. Validasi ketersediaan kursi" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_ctrl" target="ll_db"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="370" /></Array></mxGeometry></mxCell>
        <mxCell id="msg8" value="8. Return kursi tersedia (OK)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endFill=0;rounded=0;" edge="1" parent="1" source="ll_db" target="ll_ctrl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="400" /></Array></mxGeometry></mxCell>
        <mxCell id="msg9" value="9. INSERT INTO transaksis (id, user_id, kursi_list, total, status)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_ctrl" target="ll_db"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="440" /></Array></mxGeometry></mxCell>
        <mxCell id="msg10" value="10. Transaksi tersimpan (Success)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endFill=0;rounded=0;" edge="1" parent="1" source="ll_db" target="ll_ctrl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="470" /></Array></mxGeometry></mxCell>
        <mxCell id="msg11" value="11. 201 Created (JSON Response)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endFill=0;rounded=0;" edge="1" parent="1" source="ll_ctrl" target="ll_api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="500" /></Array></mxGeometry></mxCell>
        <mxCell id="msg12" value="12. Parse JSON ke TransaksiModel" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endFill=0;rounded=0;" edge="1" parent="1" source="ll_api" target="ll_prov"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="530" /></Array></mxGeometry></mxCell>
        <mxCell id="msg13" value="13. notifyListeners() &amp; return true" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endFill=0;rounded=0;" edge="1" parent="1" source="ll_prov" target="ll_ui"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="560" /></Array></mxGeometry></mxCell>
        <mxCell id="msg14" value="14. Render E-Ticket &amp; QR Code Sukses" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endFill=0;rounded=0;" edge="1" parent="1" source="ll_ui" target="ll_user"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="590" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- PAGE 4: ERD DIAGRAM -->
  <diagram id="page_erd" name="4. ERD Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Entity Relationship Diagram (ERD) - Database Bioskop" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="440" height="30" as="geometry" />
        </mxCell>

        <mxCell id="tbl_users" value="USERS&#xa;---------------------------------------&#xa;PK id : VARCHAR(255)&#xa;   name : VARCHAR(255)&#xa;   email : VARCHAR(255) [UK]&#xa;   password : VARCHAR(255)&#xa;   role : VARCHAR(50)&#xa;   created_at : TIMESTAMP&#xa;   updated_at : TIMESTAMP" style="shape=rect;whiteSpace=pre;html=1;align=left;spacingLeft=10;fillColor=#e7f5ff;strokeColor=#1971c2;fontFamily=Courier New;fontSize=12;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="240" height="150" as="geometry" />
        </mxCell>

        <mxCell id="tbl_films" value="FILMS&#xa;---------------------------------------&#xa;PK id : VARCHAR(255)&#xa;   judul : VARCHAR(255)&#xa;   genre : VARCHAR(100)&#xa;   durasi : INTEGER&#xa;   rating_usia : VARCHAR(20)&#xa;   poster_url : TEXT&#xa;   is_segera_tayang : BOOLEAN&#xa;   created_at : TIMESTAMP&#xa;   updated_at : TIMESTAMP" style="shape=rect;whiteSpace=pre;html=1;align=left;spacingLeft=10;fillColor=#e6fcf5;strokeColor=#0ca678;fontFamily=Courier New;fontSize=12;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="240" height="180" as="geometry" />
        </mxCell>

        <mxCell id="tbl_studios" value="STUDIOS&#xa;---------------------------------------&#xa;PK id : VARCHAR(255)&#xa;   nama : VARCHAR(100)&#xa;   kapasitas : INTEGER&#xa;   tipe_studio : VARCHAR(50)&#xa;   created_at : TIMESTAMP&#xa;   updated_at : TIMESTAMP" style="shape=rect;whiteSpace=pre;html=1;align=left;spacingLeft=10;fillColor=#fff9db;strokeColor=#f59f00;fontFamily=Courier New;fontSize=12;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="450" y="650" width="240" height="130" as="geometry" />
        </mxCell>

        <mxCell id="tbl_jadwals" value="JADWALS&#xa;---------------------------------------&#xa;PK id : VARCHAR(255)&#xa;FK film_id : VARCHAR(255)&#xa;FK studio_id : VARCHAR(255)&#xa;   tanggal : VARCHAR(50)&#xa;   jam_tayang : VARCHAR(50)&#xa;   harga : DECIMAL(12,2)&#xa;   created_at : TIMESTAMP&#xa;   updated_at : TIMESTAMP" style="shape=rect;whiteSpace=pre;html=1;align=left;spacingLeft=10;fillColor=#fff4e6;strokeColor=#fd7e14;fontFamily=Courier New;fontSize=12;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="450" y="440" width="240" height="160" as="geometry" />
        </mxCell>

        <mxCell id="tbl_transaksis" value="TRANSAKSIS&#xa;---------------------------------------&#xa;PK id : VARCHAR(255)&#xa;FK user_id : VARCHAR(255)&#xa;FK jadwal_id : VARCHAR(255)&#xa;   kursi_list : JSON&#xa;   total_harga : DECIMAL(12,2)&#xa;   metode_pembayaran : VARCHAR&#xa;   status : VARCHAR(50)&#xa;   tanggal_transaksi : VARCHAR&#xa;   created_at : TIMESTAMP&#xa;   updated_at : TIMESTAMP" style="shape=rect;whiteSpace=pre;html=1;align=left;spacingLeft=10;fillColor=#ffe3e3;strokeColor=#fa5252;fontFamily=Courier New;fontSize=12;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="840" y="240" width="260" height="190" as="geometry" />
        </mxCell>

        <mxCell id="tbl_drafts" value="AUTO_SAVE_DRAFTS&#xa;---------------------------------------&#xa;PK id : VARCHAR(255)&#xa;FK user_id : VARCHAR(255)&#xa;   form_key : VARCHAR(100)&#xa;   form_data : TEXT&#xa;   created_at : TIMESTAMP&#xa;   updated_at : TIMESTAMP" style="shape=rect;whiteSpace=pre;html=1;align=left;spacingLeft=10;fillColor=#f3f0ff;strokeColor=#7950f2;fontFamily=Courier New;fontSize=12;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="450" y="100" width="240" height="130" as="geometry" />
        </mxCell>

        <mxCell id="rel_u_trx" value="1 : N&#xa;melakukan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.25;strokeColor=#fa5252;strokeWidth=2;endArrow=ERmany;startArrow=ERone;" edge="1" source="tbl_users" target="tbl_transaksis" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="175" /><mxPoint x="780" y="288" /></Array></mxGeometry>
        </mxCell>

        <mxCell id="rel_u_drafts" value="1 : N&#xa;memiliki" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;strokeColor=#7950f2;strokeWidth=2;endArrow=ERmany;startArrow=ERone;" edge="1" source="tbl_users" target="tbl_drafts" parent="1">
          <mxGeometry relative="1" as="geometry" />
