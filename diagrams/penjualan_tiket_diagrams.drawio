        <mxCell id="rel_j_trx" value="1 : N&#xa;dipesan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.75;strokeColor=#fd7e14;strokeWidth=2;endArrow=ERmany;startArrow=ERone;" edge="1" source="tbl_jadwals" target="tbl_transaksis" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="520" /><mxPoint x="780" y="383" /></Array></mxGeometry>
        </mxCell>

