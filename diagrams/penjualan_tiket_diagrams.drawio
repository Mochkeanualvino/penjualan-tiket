        <mxCell id="rel_f_jadwal" value="1 : N&#xa;ditayangkan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;strokeColor=#0ca678;strokeWidth=2;endArrow=ERmany;startArrow=ERone;" edge="1" source="tbl_films" target="tbl_jadwals" parent="1">
          <mxGeometry relative="1" as="geometry" />
