        <mxCell id="rel_s_jadwal" value="1 : N&#xa;digunakan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=1;strokeColor=#f59f00;strokeWidth=2;endArrow=ERmany;startArrow=ERone;" edge="1" source="tbl_studios" target="tbl_jadwals" parent="1">
          <mxGeometry relative="1" as="geometry" />
